{
  "name": "@cocreate/pwa",
  "version": "1.24.0",
  "description": "A simple pwa component in vanilla javascript. Easily configured using HTML5 data-attributes and/or JavaScript API.",
  "keywords": [
    "pwa",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch",
    "pwa": "node ./node_modules/@cocreate/cli/src/commands/other/symlinkPwa.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreate-app/CoCreate-pwa.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-pwa/issues"
  },
  "homepage": "https://cocreate.app/docs/pwa",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/local-storage": "^1.19.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.8.0"
  },
  "allowScripts": {
    "@cocreate/actions@1.21.4": true,
    "@cocreate/local-storage@1.16.5": true,
    "@cocreate/observer@1.19.0": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}